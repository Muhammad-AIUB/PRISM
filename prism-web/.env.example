# Where prism-api answers. Server-side only — never exposed to the browser,
# which is why it has no NEXT_PUBLIC_ prefix.
PRISM_API_ORIGIN=http://127.0.0.1:3999

# Public origin of this app. Used to turn the OG image path into an absolute
# URL for link previews.
APP_URL=http://localhost:3001

# Must match SESSION_COOKIE_NAME in prism-api, or the session is never found.
SESSION_COOKIE_NAME=prism_session
