# systemd unit for the deploy webhook. Copy to /etc/systemd/system/, edit the
# paths, user and secret, then: systemctl daemon-reload && systemctl enable --now prism-deploy-webhook
# See docs/deployment.md#auto-deploy-on-push.
[Unit]
Description=PRism deploy webhook
After=network.target

[Service]
# A normal user that owns the repository checkout; not root.
User=deploy
WorkingDirectory=/srv/prism
Environment=APP_DIR=/srv/prism
Environment=DEPLOY_REPO=Muhammad-AIUB/PRISM
Environment=BRANCH=main
Environment=PORT=9000
# Keep the secret out of this file: put DEPLOY_WEBHOOK_SECRET=... in a root-only
# file (chmod 600) and point to it here.
EnvironmentFile=/etc/prism-deploy.env
ExecStart=/usr/bin/node /srv/prism/deploy/webhook.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
