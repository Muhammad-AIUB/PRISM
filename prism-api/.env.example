# prism-api environment.
#
# Copy to `.env` in THIS directory (prism-api/) and run the API from here:
#   cp .env.example .env
# Nest loads `.env` from the working directory, so never start the API from the
# repository root: the root `.env` holds production credentials.
#
# These values work with the Docker commands in docs/development.md. In
# production the same variables are set in the host's environment settings.
# Reference for every variable: docs/configuration.md

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
# 3999 is where prism-web looks for the API by default.
PORT=3999
# The public origin users browse. Used for the webhook URL
# ({APP_URL}/webhook/github) and for links in GitHub comments and Slack.
# Locally the browser talks to prism-web on :3001, which proxies to this API.
APP_URL=http://localhost:3001
# Where the browser lands after GitHub sign-in. Leave empty to use APP_URL.
FRONTEND_URL=

# Encrypts users.github_token. 32 random bytes, base64, "base64:" prefix optional.
#   node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
# Generate once and keep it. Rotating it makes every stored GitHub token
# permanently unreadable.
APP_KEY=

# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL 16. The schema is applied by hand from schema.sql; TypeORM never
# creates or alters a table. For the Docker container in docs/development.md,
# replace <password> with the POSTGRES_PASSWORD you passed to `docker run`.
DB_URL=postgres://prism:<password>@127.0.0.1:55432/prism
# "disable" turns TLS off (local Docker). Any other value enables TLS without
# certificate verification (Neon).
DB_SSLMODE=disable

# ── Redis ────────────────────────────────────────────────────────────
# IMPORTANT: the instance must run with maxmemory-policy noeviction. BullMQ
# requires it; under an eviction policy queued review jobs are dropped silently
# and the review simply never runs.
REDIS_URL=redis://127.0.0.1:56379
REDIS_PREFIX=prism:
# BullMQ's own key namespace, distinct from REDIS_PREFIX.
QUEUE_PREFIX=prism-bull

# ── AI provider ──────────────────────────────────────────────────────
# Groq, and only Groq. Required: the service will not boot without it.
# Models tried in order: llama-3.3-70b-versatile, then llama-3.1-8b-instant.
# A placeholder is enough to boot; a real key is needed to produce reviews.
GROQ_API_KEY=

# ── GitHub OAuth app ─────────────────────────────────────────────────
# Create one at GitHub -> Settings -> Developer settings -> OAuth Apps.
# The callback URL is registered on the app and is served through prism-web's
# rewrite, so it uses the WEB hostname, not the API's.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# ── Browser session ──────────────────────────────────────────────────
# Signs the session JWT. At least 32 characters, and NOT the same value as
# APP_KEY: rotating this only signs everyone out.
JWT_SECRET=
SESSION_COOKIE_NAME=prism_session
SESSION_TTL_DAYS=30

# ── Rate limiting ────────────────────────────────────────────────────
# Requests per minute. /webhook/github is fixed at 60 and /auth/* at 10.
API_RATE_LIMIT=100
