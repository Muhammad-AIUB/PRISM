# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://prism-2o7j.onrender.com

# Laravel's APP_KEY, verbatim ("base64:..."). Required to decrypt the
# `users.github_token` column written by the Laravel app.
APP_KEY=

# ── Database (same Postgres instance as Laravel — read/write, no DDL) ─
DB_URL=
DB_SSLMODE=prefer

# ── Redis (same instance; Laravel uses the "prism:" prefix) ──────────
# IMPORTANT: BullMQ requires maxmemory-policy = noeviction on this instance.
# Under an eviction policy queued review jobs can be dropped silently and the
# review simply never runs.
REDIS_URL=
REDIS_PREFIX=prism:

# ── Queue ────────────────────────────────────────────────────────────
# QUEUE_CONNECTION mirrors Laravel's value so /health reports the same thing.
# QUEUE_PREFIX is BullMQ's own key namespace, deliberately distinct from
# REDIS_PREFIX so queue keys cannot collide with Laravel's cache or sessions.
QUEUE_CONNECTION=database
QUEUE_PREFIX=prism-bull

# ── AI providers ─────────────────────────────────────────────────────
# Groq is the primary chain (native JSON mode). Leaving GROQ_API_KEY empty is
# valid and matches Laravel: the whole Groq chain is skipped and every review
# falls through to OpenRouter, which is slower and parses less reliably.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Mail (Resend, same provider as Laravel's MAIL_MAILER=resend) ─────
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=PRism AI

# ── Rate limiting (must match Laravel's RateLimiter::for('api')) ─────
# The webhook route overrides this to 60/min, matching throttle:webhook.
API_RATE_LIMIT=100
