# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://prism-2o7j.onrender.com

# Laravel's APP_KEY, verbatim ("base64:..."). Required to decrypt the
# `users.github_token` column written by the Laravel app.
APP_KEY=

# ── Database (same Postgres instance as Laravel — read/write, no DDL) ─
DB_URL=
DB_SSLMODE=prefer

# ── Redis (same instance; Laravel uses the "prism:" prefix) ──────────
# IMPORTANT: BullMQ requires maxmemory-policy = noeviction on this instance.
# Under an eviction policy queued review jobs can be dropped silently and the
# review simply never runs.
REDIS_URL=
REDIS_PREFIX=prism:

# ── Queue ────────────────────────────────────────────────────────────
# QUEUE_CONNECTION mirrors Laravel's value so /health reports the same thing.
# QUEUE_PREFIX is BullMQ's own key namespace, deliberately distinct from
# REDIS_PREFIX so queue keys cannot collide with Laravel's cache or sessions.
QUEUE_CONNECTION=database
QUEUE_PREFIX=prism-bull

# ── AI provider ──────────────────────────────────────────────────────
# Groq, and only Groq. Required — the service will not boot without it.
# Two models are tried in order (llama-3.3-70b-versatile, then
# llama-3.1-8b-instant); both use Groq's native JSON mode, which is what keeps
# unparseable output rare now that there is no second provider behind them.
GROQ_API_KEY=

# ── Mail (Resend, same provider as Laravel's MAIL_MAILER=resend) ─────
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=PRism AI

# ── GitHub OAuth (the SAME app registration Laravel uses) ────────────
# GITHUB_REDIRECT_URI must point at THIS service's /auth/github/callback
# once web auth is routed here, and be registered on the GitHub OAuth app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Browser session ──────────────────────────────────────────────────
# Signs the session JWT. NOT the same value as APP_KEY: rotating this only
# logs everyone out, whereas rotating APP_KEY would make every stored
# github_token permanently unreadable. Minimum 32 characters.
JWT_SECRET=
SESSION_COOKIE_NAME=prism_session
SESSION_TTL_DAYS=30

# Where the browser lands after OAuth. Leave empty while the frontend is
# still served from APP_URL; set it once Next.js is on its own origin.
FRONTEND_URL=

# ── Rate limiting (must match Laravel's RateLimiter::for('api')) ─────
# /webhook/github overrides this to 60/min (throttle:webhook) and /auth/*
# to 10/min (throttle:auth).
API_RATE_LIMIT=100
